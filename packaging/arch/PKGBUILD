# Maintainer: 刘传玉
# 观棋 —— KataGo 围棋 AI 引擎图形前端（本地打包，暂不提交 AUR）
#
# 打包方式（实际构建在仓库外进行，例如 /home/madoldman/build/guanqi-pkg/）：
#   1) 生成源码包（仓库根目录执行。用 git archive：只打包已提交内容，
#      天然排除 .git/target，且同一提交产出可复现的 tarball）：
#        git archive --format=tar.gz --prefix=guanqi-0.1.0/ \
#            -o /home/madoldman/build/guanqi-pkg/guanqi-0.1.0.tar.gz HEAD
#   2) 离线依赖包 vendor.tar.gz：依赖（Cargo.toml/Cargo.lock）有变动时才需重建，
#      命令 `cargo vendor <目录>` 后 `tar -czf vendor.tar.gz <目录名>`；
#      未变动就复用构建目录里已有的 vendor.tar.gz（sha256 不变，见下）。
#   3) 更新下面的 sha256sums：源码包每次必换（内容随提交变），vendor 包仅在重建时换。
#      用 `sha256sum guanqi-0.1.0.tar.gz vendor.tar.gz` 取值。
#   4) 把本 PKGBUILD 复制到构建目录（桌面入口与图标随源码包分发，无需单独复制）；
#      源码有改动时递增 pkgrel（同一上游版本的新构建，便于区分已装版本）。
#   5) makepkg -f 构建（保留构建目录里的 src/target 可增量编译），
#      然后 sudo pacman -U guanqi-<pkgver>-<pkgrel>-x86_64.pkg.tar.zst 安装。
#      装完可用 `pacman -Q guanqi` 核对版本、`grep -a 整谱快扫 /usr/bin/guanqi`
#      之类的字符串抽查确认新功能确实进了包。
#
# 共用资源：桌面入口与图标位于仓库 `resources/`（`resources/guanqi.desktop`、
# `resources/icons/guanqi.svg` 与各尺寸 PNG）—— 放仓库共用目录而非本目录，
# 供后续 RPM / DEB 等打包方式复用；本 PKGBUILD 从源码包内引用它们。

pkgname=guanqi
pkgver=0.1.0
pkgrel=2
pkgdesc='观棋 —— KataGo 围棋 AI 引擎图形前端'
arch=('x86_64')
license=('MIT')
# release 构建无调试符号，关闭 makepkg 的 debug 子包拆分（避免无意义的 guanqi-debug）
options=('!debug')

# 依赖依据：对运行中的 release 二进制 /proc/<pid>/maps 实测归纳（2026-09-19，
# Wayland 会话 + X11 display 并存环境），非仅 ldd（eframe/winit/wgpu 大量运行时 dlopen）：
#   - ldd 直接链接仅 glibc / libgcc_s / libm；其余全部 dlopen
#   - eframe 0.36.2 同时启用 glow 与 wgpu 时 Renderer::default() 选 Wgpu（Vulkan），
#     同时 wgpu 亦枚举 GL 后端，故 Vulkan 与 EGL 两套栈都需在位
depends=(
  'gcc-libs'           # libgcc_s / libstdc++（ldd 直接链接）
  'wayland'            # libwayland-client（winit Wayland 后端 dlopen）
  'libdisplay-info'    # Wayland dmabuf 反馈解析（smithay-client-toolkit dlopen）
  'libxkbcommon'       # 键盘输入，Wayland/X11 后端共用（dlopen）
  'libx11'             # X11 会话支持（winit dlopen；Wayland 会话下亦被探测加载）
  'libxcb'             # 同上（x11rb-dl 直接 dlopen libxcb.so.1）
  'xcb-util-keysyms'   # X11 键盘路径（实测被 dlopen：libxcb-keysyms.so.1）
  'libglvnd'           # libEGL（wgpu GL 后端 dlopen）
  'mesa'               # EGL/GL 实现（libEGL_mesa / libgallium）与软件渲染回退
  'vulkan-icd-loader'  # libvulkan.so.1（wgpu/Vulkan 默认渲染路径，ash dlopen）
)
makedepends=('cargo')
# 外部依赖约定（项目定死）：KataGo 引擎与权重、中文字体均不打进包，由用户自备/自选
optdepends=(
  'katago: 围棋 AI 分析引擎（主程序启动时自动在 PATH 中查找，权重与配置文件需用户自备）'
  'noto-fonts-cjk: 中文界面字体（程序按固定路径加载 /usr/share/fonts/noto-cjk/ 下字体）'
  'adobe-source-han-sans-cn-fonts: 思源黑体（中文界面字体的另一选择）'
  'vulkan-swrast: 无硬件 Vulkan 驱动时的软件渲染回退'
)

# 本地源：源码 tarball（含 resources/ 下的桌面入口与图标）+ 离线依赖 tarball。
# 注意：源码 tarball 由工作树生成，源码有任何改动都要重新生成并更新下面的第一个 sha256。
source=(
  "guanqi-$pkgver.tar.gz"
  'vendor.tar.gz'
)
sha256sums=('f5939e2498bc57b085a80ebc7aac18d142d7056f88e9bf5de6913d828495768a'
            '126bfe2b530670e39af8307d5552790bf4c408a82b3e203cb60bbe8691153ac1')

prepare() {
  cd "guanqi-$pkgver"
  # 离线构建关键：把 crates.io 源替换为 vendor 目录（cargo vendor 输出的标准配置）。
  # directory 用绝对路径，避免相对路径解析歧义。
  mkdir -p .cargo
  cat > .cargo/config.toml <<EOF
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "$srcdir/vendor"
EOF
}

build() {
  cd "guanqi-$pkgver"
  # CARGO_HOME 指向空目录：构建完全自包含，不读用户 cargo 缓存，保证 vendor 可复现
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  # 重映射源码路径：避免把构建机 $srcdir 绝对路径编进二进制（消除 makepkg 的 srcdir 引用警告）
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/guanqi"
  # --frozen = --offline + --locked：完全离线，且强制 Cargo.lock 与清单一致
  cargo build --frozen --release
}

package() {
  cd "guanqi-$pkgver"
  # 主程序（用户端只拿预编译二进制，不接触 cargo/crates.io）
  install -Dm755 "$srcdir/target/release/guanqi" "$pkgdir/usr/bin/guanqi"
  # 桌面入口与图标：来自源码包内的共用资源目录 resources/（RPM / DEB 亦复用同一批文件）
  install -Dm644 "resources/guanqi.desktop" "$pkgdir/usr/share/applications/guanqi.desktop"
  install -Dm644 "resources/icons/guanqi.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/guanqi.svg"
  local _s
  for _s in 256 128 64 48 32; do
    install -Dm644 "resources/icons/guanqi-$_s.png" \
      "$pkgdir/usr/share/icons/hicolor/${_s}x${_s}/apps/guanqi.png"
  done
  # 许可证（MIT，作者已定）
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
